# ============================================
# Stage 1: Build Dependencies
# ============================================
FROM node:20-alpine AS dependencies
WORKDIR /app
COPY package.json package-lock.json* pnpm-lock.yaml* yarn.lock* ./
RUN \
  if [ -f package-lock.json ]; then npm ci; \
  elif [ -f yarn.lock ]; then yarn install --frozen-lockfile; \
  elif [ -f pnpm-lock.yaml ]; then npm install -g pnpm && pnpm install --frozen-lockfile; \
  else npm install; \
  fi

# ============================================
# Stage 2: Prisma Client Generation
# ============================================
FROM dependencies AS prisma-gen
WORKDIR /app
COPY . .
RUN npx prisma generate

# ============================================
# Stage 3: Build Application
# ============================================
FROM dependencies AS builder
WORKDIR /app
ENV SKIP_ENV_VALIDATION=true
ENV DATABASE_URL="postgresql://dummy:dummy@localhost:5432/dummy"

COPY . .
COPY --from=prisma-gen /app/node_modules/.prisma ./node_modules/.prisma
RUN npm run build

# ============================================
# Stage 4: Production Runtime (Optimized)
# ============================================
FROM node:20-alpine AS production
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# ก๊อปปี้ไฟล์ Public
COPY --from=builder /app/public ./public

# ก๊อปปี้โฟลเดอร์ Standalone
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static

# ก๊อปปี้ Prisma Client
COPY --from=prisma-gen /app/node_modules/.prisma ./node_modules/.prisma

EXPOSE 3000

# Healthcheck API
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD node -e "require('http').get('http://localhost:3000/api/health', (r) => {if (r.statusCode !== 200) throw new Error(r.statusCode)})"

# รันด้วย node server.js (กิน RAM น้อย)
CMD ["node", "server.js"]