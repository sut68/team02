// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ========================================
// Enums
// ========================================

enum Role {
  ADMIN
  STUDENT
  ALUMNI
}

enum StudyStatus {
  ACTIVE
  GRADUATED
}

enum VerifyStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProjectStatus {
  OPEN
  CLOSED
  COMPLETED
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}
// ========================================
// Models
// ========================================

model User {
  id          Int    @id @default(autoincrement())
  email       String @unique
  password    String // hashed password
  fullName    String
  phone       String
  address     String
  subdistrict String
  district    String
  province    String
  postalCode  String
  role        Role   @default(STUDENT)

  // Legacy fields (will be removed after migration)
  studentCode   String?
  major         String?
  gradYear      String?
  userType      String? // 'student' or 'alumni'
  status        String? // 'pending', 'approved', 'rejected'
  transcriptUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  educationRecords EducationRecord[]
  verification     Verification?
  donations          DonationTransaction[]
  submissions      Submission[]
}

model EducationRecord {
  id          Int         @id @default(autoincrement())
  studentCode String      @unique
  major       String
  gradYear    Int? // ปีที่จบ (null ถ้ายังเรียนอยู่)
  status      StudyStatus @default(ACTIVE)
  transcript  String? // path ของไฟล์ transcript
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Foreign Key
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         Int          @id @default(autoincrement())
  status     VerifyStatus @default(PENDING)
  reviewedBy String? // ชื่อ admin ที่ตรวจสอบ
  reviewedAt DateTime? // วันเวลาที่ตรวจสอบ
  remark     String? // หมายเหตุ/เหตุผล
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  // Foreign Key (One-to-One)
  userId          Int           @unique
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}


// 💡 NEW MODEL: โครงการระดมทุน (DonationProject)
model DonationProject {
  id                 Int                 @id @default(autoincrement()) 
  title              String
  description        String
  goalAmount         Float
  currentAmount      Float               @default(0)
  startDate          DateTime
  endDate            DateTime
  ownerName          String
  contact            String
  
  // status (ใช้ Enum ใหม่)
  status             ProjectStatus       @default(OPEN)
  posterUrl          String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  // Relations
  transactions       DonationTransaction[] // ความสัมพันธ์ 1-to-Many กับ Transaction
}


// 💡 NEW MODEL: ธุรกรรมการบริจาค (DonationTransaction)
model DonationTransaction {
  id                 Int                 @id @default(autoincrement())
  
  amount             Float
  
  // สถานะการทำธุรกรรม (Pending, Success, Failed)
  status             TransactionStatus   @default(PENDING)
  
  // Omise/Payment Gateway Reference IDs
  omiseChargeId      String              @unique // Omise Charge ID (ใช้ในการตรวจสอบ Webhook)
  
  // ข้อมูลผู้บริจาค (ถ้าผู้ใช้ไม่ได้ Login, อาจ null ได้)
  donorName          String?             // ชื่อที่ผู้ใช้ระบุในฟอร์ม (ถ้าไม่ Login)
  donorEmail         String?
  
  // ความสัมพันธ์กับ User (ถ้าบริจาคโดย Login)
  userId             Int?
  user               User?               @relation(fields: [userId], references: [id])
  
  // ความสัมพันธ์กับ Project
  projectId          Int
  project            DonationProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

//kk
model Submission {
  id     Int          @id @default(autoincrement())
  Name   String
  Date   DateTime
  status VerifyStatus @default(PENDING)
  remark String?

  fileId Int?            @unique // 1 submission มีไฟล์หลักได้แค่ 1 อัน
  file   SubmissionFile? @relation(fields: [fileId], references: [id])
  userId Int
  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SubmissionFile {
  id   Int    @id @default(autoincrement())
  Path String

  submission Submission? // back relation (optional)
}

