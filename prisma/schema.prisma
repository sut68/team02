// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ========================================
// Enums
// ========================================

enum Role {
  ADMIN
  STUDENT
  ALUMNI
}

enum StudyStatus {
  ACTIVE
  GRADUATED
}

enum VerifyStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TopicStatus {
  ACTIVE
  HIDDEN
  DELETED
}

enum CommentStatus {
  ACTIVE
  HIDDEN
  DELETED
}

enum ContentTargetType {
  TOPIC
  COMMENT
}

enum ContentActionStatus {
  APPROVED
  HIDDEN
  DELETED
}

enum ProjectStatus {
  OPEN
  CLOSED
  COMPLETED
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}
enum PaymentMethodType {
  PROMPTPAY
  CREDIT_CARD
  BANK_TRANSFER
}

enum PaymentStatusType {
  CONFIRMED
  CANCELLED
  REFUNDED
}

// ========================================
// Models
// ========================================

model User {
  id          Int    @id @default(autoincrement())
  email       String @unique
  password    String // hashed password
  fullName    String
  phone       String
  address     String
  subdistrict String
  district    String
  province    String
  postalCode  String
  role        Role   @default(STUDENT)

  // Legacy fields (will be removed after migration)
  studentCode   String?
  major         String?
  gradYear      String?
  userType      String? // 'student' or 'alumni'
  status        String? // 'pending', 'approved', 'rejected'
  transcriptUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  educationRecords   EducationRecord[]
  verification       Verification?
  submissions        Submission[]
  eventRegistrations EventRegistration[]
  donations          Donation[]
  entitlements       Entitlement[]
  redemptions        Redemption[]
  shipments          Shipment[]
  bookings           Booking[]
  contents           Content[]

  // Budget System Relations
  proposalsAsStaff    ProjectProposal[]   @relation("StaffProposals")
  summarySubmissions  SummarySubmission[]
  budgetDonations     BudgetDonation[]
  projectVotes        ProjectVote[]
  createdBudgetRounds BudgetRound[]

  // Forum System Relations
  topics                Topic[]
  comments              Comment[]
  contentManagementLogs ContentManagementLog[]

  // Donation Project Relations
  donationTransactions DonationTransaction[]
}

model EducationRecord {
  id          Int         @id @default(autoincrement())
  studentCode String      @unique
  major       String
  gradYear    Int? // ปีที่จบ (null ถ้ายังเรียนอยู่)
  status      StudyStatus @default(ACTIVE)
  transcript  String? // path ของไฟล์ transcript
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Foreign Key
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         Int          @id @default(autoincrement())
  status     VerifyStatus @default(PENDING)
  reviewedBy String? // ชื่อ admin ที่ตรวจสอบ
  reviewedAt DateTime? // วันเวลาที่ตรวจสอบ
  remark     String? // หมายเหตุ/เหตุผล
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  // Foreign Key (One-to-One)
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// 💡 NEW MODEL: โครงการระดมทุน (DonationProject)
model DonationProject {
  id            Int      @id @default(autoincrement())
  title         String
  description   String
  goalAmount    Float
  currentAmount Float    @default(0)
  startDate     DateTime
  endDate       DateTime
  ownerName     String
  contact       String

  // status (ใช้ Enum ใหม่)
  status    ProjectStatus @default(OPEN)
  posterUrl String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  // Relations
  transactions DonationTransaction[] // ความสัมพันธ์ 1-to-Many กับ Transaction
}

// 💡 NEW MODEL: ธุรกรรมการบริจาค (DonationTransaction)
model DonationTransaction {
  id Int @id @default(autoincrement())

  amount Float

  // สถานะการทำธุรกรรม (Pending, Success, Failed)
  status TransactionStatus @default(PENDING)

  // Omise/Payment Gateway Reference IDs
  omiseChargeId String @unique // Omise Charge ID (ใช้ในการตรวจสอบ Webhook)

  // ข้อมูลผู้บริจาค (ถ้าผู้ใช้ไม่ได้ Login, อาจ null ได้)
  donorName  String? // ชื่อที่ผู้ใช้ระบุในฟอร์ม (ถ้าไม่ Login)
  donorEmail String?
  isPublic   Boolean @default(true) // แสดงชื่อผู้บริจาคสาธารณะหรือไม่

  // ความสัมพันธ์กับ User (ถ้าบริจาคโดย Login)
  userId Int?
  user   User? @relation(fields: [userId], references: [id])

  // ความสัมพันธ์กับ Project
  projectId Int
  project   DonationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  paymentRecords PaymentRecord[]
}

//kk
model Submission {
  id     Int          @id @default(autoincrement())
  Name   String
  Date   DateTime
  status VerifyStatus @default(PENDING)
  remark String?

  fileId Int?            @unique // 1 submission มีไฟล์หลักได้แค่ 1 อัน
  file   SubmissionFile? @relation(fields: [fileId], references: [id])
  userId Int
  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SubmissionFile {
  id   Int    @id @default(autoincrement())
  Path String

  submission Submission? // back relation (optional)
}

// ========================================
// Event & Registration (Subsystem reference)
// ========================================

model Event {
  id             Int            @id @default(autoincrement())
  name           String
  description    String?
  startDate      DateTime
  endDate        DateTime?
  location       String?
  maxAttendees   Int?
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  souvenirItemId Int?
  souvenirItem   SouvenirItem?  @relation(fields: [souvenirItemId], references: [id])

  registrations EventRegistration[]
  entitlements  Entitlement[]
}

model EventRegistration {
  id               Int      @id @default(autoincrement())
  eventId          Int
  userId           Int
  registeredAt     DateTime @default(now())
  attendanceStatus String? // "registered" | "attended" | "absent"

  event        Event         @relation(fields: [eventId], references: [id])
  user         User          @relation(fields: [userId], references: [id])
  entitlements Entitlement[]

  @@unique([eventId, userId])
}

// ========================================
// Donation (Subsystem reference)
// ========================================

model Donation {
  id             Int            @id @default(autoincrement())
  userId         Int
  amount         Float
  donatedAt      DateTime       @default(now())
  purpose        String?
  status         String         @default("completed") // "pending" | "completed" | "failed"
  souvenirItemId Int?
  souvenirItem   SouvenirItem?  @relation(fields: [souvenirItemId], references: [id])

  user         User          @relation(fields: [userId], references: [id])
  entitlements Entitlement[]
  shipments    Shipment[]

  @@map("Donation")
}

// ========================================
// Souvenir Subsystem
// ========================================

// ของที่ระลึกแต่ละชิ้น
model SouvenirItem {
  id          Int     @id @default(autoincrement())
  sku         String  @unique // โค้ดสินค้า เช่น CAP-ENGI-2025-BK
  name        String
  description String?
  category    String? // เช่น "กิจกรรม", "บริจาค"
  imageUrl    String?
  unit        String? // เช่น "ชิ้น", "ใบ", "เซ็ต"

  initialStock Int     @default(0) // สต็อกเริ่มต้น
  active       Boolean @default(true)

  // ความสัมพันธ์ฝั่งของที่ระลึก
  movements    StockMovement[]
  entitlements Entitlement[]
  redemptions  Redemption[]
  shipments    Shipment[]
  events       Event[]
  donations    Donation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// บันทึกการเคลื่อนไหวสต็อก (เติม/ตัดของ)
// คงเหลือจริง = initialStock + SUM(delta)
model StockMovement {
  id        Int      @id @default(autoincrement())
  itemId    Int
  delta     Int // + เพิ่มสต็อก, - ตัดสต็อก
  reason    String? // "purchase" | "manual_adjust" | "redeem" | "ship"
  refType   String? // "Redemption" | "Shipment" | ...
  createdBy Int? // เก็บ userId ของ admin ก็ได้
  createdAt DateTime @default(now())

  item SouvenirItem @relation(fields: [itemId], references: [id])
}

// ใบสิทธิ์รับของของแต่ละคน (จากกิจกรรม หรือการบริจาค)
model Entitlement {
  id                  Int               @id @default(autoincrement())
  userId              Int
  itemId              Int
  source              EntitlementSource // EVENT | DONATION
  eventId             Int? // อ้างถึงกิจกรรม (ถ้ามาจาก EVENT)
  eventRegistrationId Int? // ถ้ามาจากกิจกรรม
  donationId          Int? // ถ้ามาจากบริจาค

  qtyGranted Int @default(1) // ได้สิทธิ์ทั้งหมดกี่ชิ้น
  qtyUsed    Int @default(0) // ใช้สิทธิ์ไปแล้วกี่ชิ้น

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user              User               @relation(fields: [userId], references: [id])
  item              SouvenirItem       @relation(fields: [itemId], references: [id])
  event             Event?             @relation(fields: [eventId], references: [id])
  eventRegistration EventRegistration? @relation(fields: [eventRegistrationId], references: [id])
  donation          Donation?          @relation(fields: [donationId], references: [id])

  redemptions Redemption[]

  @@index([userId, itemId])
}

// การแลกรับของจริง (ใช้ตอนสแกน QR หรือให้ของด้วยมือ)
model Redemption {
  id            Int          @id @default(autoincrement())
  entitlementId Int // สิทธิ์ที่ใช้
  itemId        Int
  userId        Int // เจ้าของสิทธิ์
  method        RedeemMethod @default(QR_SCAN) // QR_SCAN | MANUAL
  redeemedAt    DateTime     @default(now())
  handledBy     Int? // เก็บ userId ของเจ้าหน้าที่

  entitlement Entitlement  @relation(fields: [entitlementId], references: [id])
  item        SouvenirItem @relation(fields: [itemId], references: [id])
  user        User         @relation(fields: [userId], references: [id])
}

// การจัดส่งของที่ระลึก (สำหรับสายบริจาค/ส่งถึงบ้าน)
model Shipment {
  id         Int @id @default(autoincrement())
  donationId Int // มาจากการบริจาคอันไหน
  userId     Int // ผู้รับ (เจ้าของสิทธิ์)
  itemId     Int
  qty        Int @default(1)

  receiverName String
  addressLine  String
  subdistrict  String
  district     String
  province     String
  postalCode   String
  phone        String

  status     ShipStatus @default(PENDING) // PENDING | DELIVERED 
  trackingNo String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  donation Donation     @relation(fields: [donationId], references: [id])
  user     User         @relation(fields: [userId], references: [id])
  item     SouvenirItem @relation(fields: [itemId], references: [id])
}

// ========================================
// Souvenir Enums
// ========================================

enum EntitlementSource {
  EVENT
  DONATION
}

enum RedeemMethod {
  QR_SCAN
  MANUAL
}

enum ShipStatus {
  PENDING
  IN_TRANSIT
  DELIVERED
  FAILED
}

// ========================================
// Booking & Event Management Enums
// ========================================

enum EventType {
  REUNION
  CAMP
  SEMINAR
  WORKSHOP
  OTHER
}

enum PriceMode {
  SINGLE
  BY_BATCH
  FREE
}

enum ContentCategoryType {
  NEWS
  EVENT
  ANNOUNCEMENT
  ACTIVITY
  GENERAL
}

enum Option {
  HAVE
  NOT
}


// ========================================
// Booking & Content Management System
// ========================================

// ฟอร์มจองงานกิจกรรม/อีเวนต์
model BookingForm {
  id          Int        @id @default(autoincrement())
  Type        EventType?
  BatchNumber Int?
  TotalSeats  Int?
  StartDate   DateTime?
  EndDate     DateTime?
  PriceType   PriceMode?
  singlePrice Int? // ใช้เมื่อ PriceType = SINGLE
  batchPrices Json? // ใช้ตอน PriceType = BY_BATCH
  Souvenir    Option? // ฟอร์มนี้มีของที่ระลึกไหม (HAVE/NOT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contents Content[]
  bookings Booking[]
}

// ข้อมูลที่ผู้ใช้กรอกในแต่ละการจอง
model BookingField {
  id           Int     @id @default(autoincrement())
  BatchNumber  String?
  BookingSeats Int?
  Name1        String?
  Name2        String?
  Name3        String?
  Name4        String?
  TotalPrice   Int?
  Souvenir     String?
  Note         String?

  booking Booking? // 1:1 relation from Booking side
}

// การจองของผู้ใช้
model Booking {
  id                Int               @id @default(autoincrement())
  Date              DateTime          @default(now())
  Userid            Int?
  ContentID         Int?
  BookingFieldID    Int?              @unique
  PaymentID         Int?              @unique
  transactionStatus TransactionStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User?         @relation(fields: [Userid], references: [id])
  content      Content?      @relation(fields: [ContentID], references: [id])
  bookingField BookingField? @relation(fields: [BookingFieldID], references: [id])
  payment      Payment?      @relation(fields: [PaymentID], references: [id])
  bookingForm  BookingForm?  @relation(fields: [bookingFormId], references: [id])

  bookingFormId Int?
  attendees     Attendee[]
}

// ผู้เข้าร่วมในแต่ละการจอง
model Attendee {
  id        Int    @id @default(autoincrement())
  Name      String
  bookingId Int

  createdAt DateTime @default(now())

  booking  Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  checkins CheckinLog[]
}

// บันทึกการเช็คอิน
model CheckinLog {
  id         Int      @id @default(autoincrement())
  Date       DateTime @default(now())
  Name       String?
  AttendeeID Int

  attendee Attendee @relation(fields: [AttendeeID], references: [id], onDelete: Cascade)
}

// เนื้อหา/ข่าวสาร/กิจกรรม
model Content {
  id            Int                  @id @default(autoincrement())
  TitleName         String?
  Description   String?
  categories    ContentCategoryType?
  Booking       Option?
  Userid        Int?
  BookingFormID Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User?        @relation(fields: [Userid], references: [id])
  bookingForm BookingForm? @relation(fields: [BookingFormID], references: [id])

  pictures PictureContent[]
  bookings Booking[]
}

// รูปภาพที่เกี่ยวข้องกับเนื้อหา
model PictureContent {
  id        Int    @id @default(autoincrement())
  Path      String
  ContentID Int

  createdAt DateTime @default(now())

  content Content @relation(fields: [ContentID], references: [id], onDelete: Cascade)
}

// การชำระเงิน
model Payment {
  id            Int               @id @default(autoincrement())
  amount        Float
  paymentDate   DateTime          @default(now())
  paymentMethod String? // เช่น "credit_card", "bank_transfer", "qr_code"
  status        TransactionStatus @default(PENDING)
  referenceNo   String? // เลขที่อ้างอิง/slip

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking Booking?
}

// ========================================
// Budget & Project Management System
// ========================================

enum ProjectProposalStatus {
  PENDING
  OPEN
  CLOSE
  APPROVED
}

enum SummarySubmissionStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  NEEDS_REVISION
}

enum RoundStatus {
  PREPARING // กำลังเตรียม (ค่า Default)
  OPEN      // เปิดรับบริจาค/โหวต
  CLOSED    // ปิดแล้ว
}

// ผู้จัดการโครงการ
model ProjectManager {
  id          Int     @id @default(autoincrement())
  firstName   String
  lastName    String
  department  String?
  position    String?
  phoneNumber String?
  email       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proposals ProjectProposal[]
}

// รอบงบประมาณ
model BudgetRound {
  id          Int       @id @default(autoincrement())
  roundName   String
  fiscalYear  String?
  totalBudget Float?
  startDate   DateTime?
  endDate     DateTime?
  status      RoundStatus @default(PREPARING)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  creatorId Int?
  creator   User? @relation(fields: [creatorId], references: [id])

  proposals       ProjectProposal[]
  budgetDonations BudgetDonation[]
}

// ข้อเสนอโครงการ
model ProjectProposal {
  id                 Int       @id @default(autoincrement())
  projectName        String
  objective          String?
  description        String?   @db.Text
  requestedAmount    Float?
  projectStartDate   DateTime?
  projectEndDate     DateTime?
  scoreTotal         Int       @default(0)
  responsibilityUnit String?
  coverFilePath      String?

  status ProjectProposalStatus @default(PENDING)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  budgetRoundId Int?
  managerId     Int?
  staffId       Int?

  budgetRound BudgetRound?    @relation(fields: [budgetRoundId], references: [id])
  manager     ProjectManager? @relation(fields: [managerId], references: [id])
  staff       User?           @relation("StaffProposals", fields: [staffId], references: [id])

  summarySubmissions SummarySubmission[]
  votes              ProjectVote[]
}

// การส่งสรุปโครงการ
model SummarySubmission {
  id                 Int       @id @default(autoincrement())
  totalActualExpense Float?
  summaryFilePath    String?
  submissionDate     DateTime?

  status SummarySubmissionStatus @default(DRAFT)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  proposalId  Int
  submitterId Int?

  proposal  ProjectProposal   @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  submitter User?             @relation(fields: [submitterId], references: [id])
  images    SubmissionImage[]
}

// รูปภาพสรุปโครงการ
model SubmissionImage {
  id        Int    @id @default(autoincrement())
  imagePath String

  createdAt DateTime @default(now())

  submissionId Int
  submission   SummarySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

// การบริจาคเข้ารอบงบประมาณ
model BudgetDonation {
  id     Int   @id @default(autoincrement())
  amount Float

  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?

  budgetRoundId Int
  userId        Int

  budgetRound BudgetRound @relation(fields: [budgetRoundId], references: [id])
  user        User        @relation(fields: [userId], references: [id])
}

// การโหวตโครงการ
model ProjectVote {
  id         Int @id @default(autoincrement())
  voteWeight Int @default(1)

  alumniId   Int
  proposalId Int

  alumni   User            @relation(fields: [alumniId], references: [id])
  proposal ProjectProposal @relation(fields: [proposalId], references: [id])

  createdAt DateTime @default(now())

  @@unique([alumniId, proposalId])
}

// ========================================
// Community Forum System
// ========================================

// หมวดหมู่กระทู้
model Category {
  id           Int    @id @default(autoincrement())
  categoryname String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  topics Topic[]
}

// กระทู้หลัก
model Topic {
  id               Int         @id @default(autoincrement())
  title            String
  content          String      @db.Text
  topicImage       String?
  status           TopicStatus @default(ACTIVE)
  createddate      DateTime    @default(now())
  lastactivitydate DateTime    @default(now())
  commentcount     Int         @default(0)

  user_id     Int
  category_id Int

  user     User     @relation(fields: [user_id], references: [id])
  category Category @relation(fields: [category_id], references: [id])

  comments    Comment[]
  editHistory TopicEditHistory[]

  @@index([user_id])
  @@index([category_id])
  @@index([status])
  @@index([createddate])
}

// ควาศคิดเห็น
model Comment {
  id           Int           @id @default(autoincrement())
  content      String        @db.Text
  createddate  DateTime      @default(now())
  status       CommentStatus @default(ACTIVE)
  commentcount Int           @default(0)

  topic_id Int
  user_id  Int

  topic Topic @relation(fields: [topic_id], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [user_id], references: [id])

  @@index([topic_id])
  @@index([user_id])
  @@index([status])
}

// ประวัติการแก้ไขกระทู้
model TopicEditHistory {
  id             Int      @id @default(autoincrement())
  editedByUserID String
  oldcontent     String   @db.Text
  editdate       DateTime @default(now())

  staffuser_id Int?
  topic_id     Int

  topic Topic @relation(fields: [topic_id], references: [id], onDelete: Cascade)

  @@index([topic_id])
}

// Audit Log สำหรับการจัดการเนื้อหา
model ContentManagementLog {
  id         Int                 @id @default(autoincrement())
  targettype ContentTargetType
  TargetID   Int
  status     ContentActionStatus
  reason     String?
  actiondate DateTime            @default(now())

  staffuser_id Int

  staff User @relation(fields: [staffuser_id], references: [id])

  @@index([targettype, TargetID])
  @@index([staffuser_id])
}

// ========================================
// Donation Project & Payment System
// ========================================

// วิธีการชำระเงิน
model PaymentMethodRecord {
  id            Int               @id @default(autoincrement())
  methodName    PaymentMethodType @default(PROMPTPAY)
  accountNumber String?
  provider      String?
  isActive      Boolean           @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments PaymentRecord[]
}

// บันทึกการชำระเงิน
model PaymentRecord {
  id Int @id @default(autoincrement())

  // Omise/Payment Gateway ID
  paymentRefId String? @unique

  amount          Float
  transactionCode String?
  paymentSlipUrl  String? // url ของสลิป

  paymentStatus PaymentStatusType @default(CONFIRMED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  paymentMethodId Int?
  paymentMethod   PaymentMethodRecord? @relation(fields: [paymentMethodId], references: [id])

  transaction           DonationTransaction? @relation(fields: [donationTransactionId], references: [id])
  donationTransactionId Int?

  @@index([paymentStatus])
  @@index([createdAt])
}
