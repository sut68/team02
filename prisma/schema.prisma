// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ========================================
// Enums
// ========================================

enum Role {
  ADMIN
  STUDENT
  ALUMNI
}

enum StudyStatus {
  ACTIVE
  GRADUATED
}

enum VerifyStatus {
  PENDING
  APPROVED
  REJECTED
}

// ========================================
// Models
// ========================================

model User {
  id              Int                @id @default(autoincrement())
  email           String             @unique
  password        String             // hashed password
  fullName        String
  phone           String
  address         String
  subdistrict     String
  district        String
  province        String
  postalCode      String
  role            Role               @default(STUDENT)
  
  // Legacy fields (will be removed after migration)
  studentCode     String?
  major           String?
  gradYear        String?
  userType        String?            // 'student' or 'alumni'
  status          String?            // 'pending', 'approved', 'rejected'
  transcriptUrl   String?
  
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  
  // Relations
  educationRecords EducationRecord[]
  verification     Verification?
}

model EducationRecord {
  id              Int           @id @default(autoincrement())
  studentCode     String        @unique
  major           String
  gradYear        Int?          // ปีที่จบ (null ถ้ายังเรียนอยู่)
  status          StudyStatus   @default(ACTIVE)
  transcript      String?       // path ของไฟล์ transcript
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  // Foreign Key
  userId          Int
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id              Int           @id @default(autoincrement())
  status          VerifyStatus  @default(PENDING)
  reviewedBy      String?       // ชื่อ admin ที่ตรวจสอบ
  reviewedAt      DateTime?     // วันเวลาที่ตรวจสอบ
  remark          String?       // หมายเหตุ/เหตุผล
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  // Foreign Key (One-to-One)
  userId          Int           @unique
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}