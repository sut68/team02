// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ========================================
// Enums
// ========================================

enum Role {
  ADMIN
  STUDENT
  ALUMNI
}

enum StudyStatus {
  ACTIVE
  GRADUATED
}

enum VerifyStatus {
  PENDING
  APPROVED
  REJECTED
}

// ========================================
// Models
// ========================================

model User {
  id          Int    @id @default(autoincrement())
  email       String @unique
  password    String // hashed password
  fullName    String
  phone       String
  address     String
  subdistrict String
  district    String
  province    String
  postalCode  String
  role        Role   @default(STUDENT)

  // Legacy fields (will be removed after migration)
  studentCode   String?
  major         String?
  gradYear      String?
  userType      String? // 'student' or 'alumni'
  status        String? // 'pending', 'approved', 'rejected'
  transcriptUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  educationRecords  EducationRecord[]
  verification      Verification?
  submissions       Submission[]
  eventRegistrations EventRegistration[]
  donations         Donation[]
  entitlements      Entitlement[]
  redemptions       Redemption[]
  shipments         Shipment[]
}

model EducationRecord {
  id          Int         @id @default(autoincrement())
  studentCode String      @unique
  major       String
  gradYear    Int? // ปีที่จบ (null ถ้ายังเรียนอยู่)
  status      StudyStatus @default(ACTIVE)
  transcript  String? // path ของไฟล์ transcript
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Foreign Key
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         Int          @id @default(autoincrement())
  status     VerifyStatus @default(PENDING)
  reviewedBy String? // ชื่อ admin ที่ตรวจสอบ
  reviewedAt DateTime? // วันเวลาที่ตรวจสอบ
  remark     String? // หมายเหตุ/เหตุผล
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  // Foreign Key (One-to-One)
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

//kk
model Submission {
  id     Int          @id @default(autoincrement())
  Name   String
  Date   DateTime
  status VerifyStatus @default(PENDING)
  remark String?

  fileId Int?            @unique // 1 submission มีไฟล์หลักได้แค่ 1 อัน
  file   SubmissionFile? @relation(fields: [fileId], references: [id])
  userId Int
  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SubmissionFile {
  id   Int    @id @default(autoincrement())
  Path String

  submission Submission? // back relation (optional)
}

// ========================================
// Event & Registration (Subsystem reference)
// ========================================

model Event {
  id            Int      @id @default(autoincrement())
  name          String
  description   String?
  startDate     DateTime
  endDate       DateTime?
  location      String?
  maxAttendees  Int?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  registrations EventRegistration[]
  entitlements  Entitlement[]
}

model EventRegistration {
  id             Int      @id @default(autoincrement())
  eventId        Int
  userId         Int
  registeredAt   DateTime @default(now())
  attendanceStatus String? // "registered" | "attended" | "absent"
  
  event          Event    @relation(fields: [eventId], references: [id])
  user           User     @relation(fields: [userId], references: [id])
  entitlements   Entitlement[]

  @@unique([eventId, userId])
}

// ========================================
// Donation (Subsystem reference)
// ========================================

model Donation {
  id          Int      @id @default(autoincrement())
  userId      Int
  amount      Float
  donatedAt   DateTime @default(now())
  purpose     String?
  status      String   @default("completed") // "pending" | "completed" | "failed"
  
  user        User     @relation(fields: [userId], references: [id])
  entitlements Entitlement[]
  shipments   Shipment[]
}

// ========================================
// Souvenir Subsystem
// ========================================

// ของที่ระลึกแต่ละชิ้น
model SouvenirItem {
  id           Int      @id @default(autoincrement())
  sku          String   @unique        // โค้ดสินค้า เช่น CAP-ENGI-2025-BK
  name         String
  description  String?
  category     String?                  // เช่น "กิจกรรม", "บริจาค"
  imageUrl     String?
  unit         String?                  // เช่น "ชิ้น", "ใบ", "เซ็ต"

  initialStock Int      @default(0)    // สต็อกเริ่มต้น
  active       Boolean  @default(true)

  // ความสัมพันธ์ฝั่งของที่ระลึก
  movements    StockMovement[]
  entitlements Entitlement[]
  redemptions  Redemption[]
  shipments    Shipment[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// บันทึกการเคลื่อนไหวสต็อก (เติม/ตัดของ)
// คงเหลือจริง = initialStock + SUM(delta)
model StockMovement {
  id        Int      @id @default(autoincrement())
  itemId    Int
  delta     Int                     // + เพิ่มสต็อก, - ตัดสต็อก
  reason    String?                 // "purchase" | "manual_adjust" | "redeem" | "ship"
  refType   String?                 // "Redemption" | "Shipment" | ...
  createdBy Int?                    // เก็บ userId ของ admin ก็ได้
  createdAt DateTime @default(now())

  item      SouvenirItem @relation(fields: [itemId], references: [id])
}

// ใบสิทธิ์รับของของแต่ละคน (จากกิจกรรม หรือการบริจาค)
model Entitlement {
  id                  Int                @id @default(autoincrement())
  userId              Int
  itemId              Int
  source              EntitlementSource  // EVENT | DONATION
  eventId             Int?               // อ้างถึงกิจกรรม (ถ้ามาจาก EVENT)
  eventRegistrationId Int?               // ถ้ามาจากกิจกรรม
  donationId          Int?               // ถ้ามาจากบริจาค

  qtyGranted          Int      @default(1)  // ได้สิทธิ์ทั้งหมดกี่ชิ้น
  qtyUsed             Int      @default(0)  // ใช้สิทธิ์ไปแล้วกี่ชิ้น

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user                User               @relation(fields: [userId], references: [id])
  item                SouvenirItem       @relation(fields: [itemId], references: [id])
  event               Event?             @relation(fields: [eventId], references: [id])
  eventRegistration   EventRegistration? @relation(fields: [eventRegistrationId], references: [id])
  donation            Donation?          @relation(fields: [donationId], references: [id])

  redemptions         Redemption[]

  @@index([userId, itemId])
}

// การแลกรับของจริง (ใช้ตอนสแกน QR หรือให้ของด้วยมือ)
model Redemption {
  id            Int          @id @default(autoincrement())
  entitlementId Int          // สิทธิ์ที่ใช้
  itemId        Int
  userId        Int          // เจ้าของสิทธิ์
  method        RedeemMethod @default(QR_SCAN)  // QR_SCAN | MANUAL
  redeemedAt    DateTime     @default(now())
  handledBy     Int?         // เก็บ userId ของเจ้าหน้าที่

  entitlement   Entitlement  @relation(fields: [entitlementId], references: [id])
  item          SouvenirItem @relation(fields: [itemId], references: [id])
  user          User         @relation(fields: [userId], references: [id])
}

// การจัดส่งของที่ระลึก (สำหรับสายบริจาค/ส่งถึงบ้าน)
model Shipment {
  id           Int        @id @default(autoincrement())
  donationId   Int        // มาจากการบริจาคอันไหน
  userId       Int        // ผู้รับ (เจ้าของสิทธิ์)
  itemId       Int
  qty          Int        @default(1)

  receiverName String
  addressLine  String
  subdistrict  String
  district     String
  province     String
  postalCode   String
  phone        String

  status       ShipStatus @default(PENDING)    // PENDING | DELIVERED 
  trackingNo   String?

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  donation     Donation     @relation(fields: [donationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  item         SouvenirItem @relation(fields: [itemId], references: [id])
}

// ========================================
// Souvenir Enums
// ========================================

enum EntitlementSource {
  EVENT
  DONATION
}

enum RedeemMethod {
  QR_SCAN
  MANUAL
}

enum ShipStatus {
  PENDING
  DELIVERED
}

